{
    "name": "yotpo/woocommerce-plugin",
    "description": "Development tooling for the Yotpo Product Reviews plugin. Only trunk/ is shipped to WordPress.org.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^3.0",
        "phpcompatibility/php-compatibility": "^10.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "bin/php-lint.sh",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    }
}
