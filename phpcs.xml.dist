<?xml version="1.0"?>
<ruleset name="Yotpo WooCommerce">
	<description>
		Security, correctness and PHP-compatibility checks for the shipped plugin (trunk/).
		Formatting sniffs (WordPress-Core whitespace, braces, comments) are intentionally not
		enabled yet, so the report stays focused on real defects.
	</description>

	<file>trunk</file>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<!--
		These two values are the tooling/dev-process floor targeted for the upcoming 1.8.3
		work, not the plugin's currently-published minimums. They intentionally differ, for
		now, from trunk/readme.txt's "Minimum Requirements" section (PHP 5.2.0+ / WordPress
		3.5.1+), which still reflects what's actually shipped on WordPress.org. Expect the two
		to be reconciled when the plugin's real minimums are bumped as part of 1.8.3 — until
		then, neither value should be read as a stale or wrong duplicate of the other.
	-->
	<!-- Lowest WordPress version we actually support (drives deprecated-function checks). -->
	<config name="minimum_wp_version" value="6.0"/>
	<!-- Lowest PHP version we actually support. -->
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.CodeAnalysis"/>
	<rule ref="WordPress.WP">
		<!-- The plugin has no translations yet; enable once a text domain is added. -->
		<exclude name="WordPress.WP.I18n"/>
	</rule>
	<rule ref="WordPress.PHP">
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Deprecated in WPCS 3.3; PHPCompatibility covers it. -->
		<exclude name="WordPress.PHP.POSIXFunctions"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wc_yotpo"/>
				<element value="yotpo"/>
			</property>
		</properties>
	</rule>
</ruleset>
